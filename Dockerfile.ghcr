# Dockerfile.ghcr — Minimal image for GitHub Packages (ghcr.io) publishing.
# Receives a pre-built binary from the CI build job; no cargo build inside.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /usr/sbin/nologin sharecli

COPY bin/sharecli /usr/local/bin/sharecli
RUN chmod 555 /usr/local/bin/sharecli

USER sharecli
EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://127.0.0.1:9000/healthz || exit 1

ENTRYPOINT ["sharecli"]
CMD ["serve", "--bind", "0.0.0.0:9000"]
