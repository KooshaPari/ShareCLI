{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://phenotype.local/schemas/mature-recovery-work-packages-v1.json",
  "title":"Mature Recovery Work Package Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","product","source_snapshot","packages"],
  "properties":{
    "schema":{"const":"mature-recovery-work-packages/v1"},
    "product":{"type":"string","minLength":1},
    "source_snapshot":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "packages":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","tier","title","depends_on","merge_gate","critical","evidence_required"],
        "properties":{
          "id":{"type":"string","pattern":"^[A-Z]+-WP-[AB][0-9]{2}$"},
          "tier":{"enum":["A","B"]},
          "title":{"type":"string","minLength":1},
          "depends_on":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
          "merge_gate":{"enum":["READY","BLOCKED"]},
          "blocked_by":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "critical":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "evidence_required":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
        },
        "allOf":[
          {"if":{"properties":{"merge_gate":{"const":"BLOCKED"}}},"then":{"required":["blocked_by"],"properties":{"blocked_by":{"minItems":1}}}},
          {"if":{"properties":{"tier":{"const":"A"}}},"then":{"properties":{"merge_gate":{"const":"READY"}}}}
        ]
      }
    }
  }
}
